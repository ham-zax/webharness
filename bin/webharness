#!/usr/bin/env bash
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"

usage() {
  cat <<'EOF'
WebHarness operator CLI

Usage:
  webharness setup --profile restricted|trusted-dev|personal|server [--enable-startup] [--env-file PATH] [--state-dir PATH]
  webharness doctor [--profile restricted|trusted-dev|personal|server] [--env-file PATH] [--state-dir PATH]
  webharness start
  webharness stop
  webharness restart [--wait] [--timeout SECONDS]
  webharness status
  webharness extension list|install|remove ...
  webharness help
EOF
}

install_self() {
  local user_bin link
  user_bin="${WEBHARNESS_USER_BIN_DIR:-${HOME:?HOME is required}/.local/bin}"
  link="$user_bin/webharness"
  mkdir -p "$user_bin"
  if { [ -e "$link" ] || [ -L "$link" ]; } && [ ! -L "$link" ]; then
    echo "refusing to replace non-symlink $link" >&2
    return 1
  fi
  ln -sfn "$ROOT/bin/webharness" "$link"
  echo "installed webharness: $link -> $ROOT/bin/webharness"
}

systemd_bridge_available() {
  local runtime_dir bus_address
  runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  bus_address="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$runtime_dir/bus}"
  command -v systemctl >/dev/null 2>&1 && [ -S "$runtime_dir/bus" ] && \
    XDG_RUNTIME_DIR="$runtime_dir" DBUS_SESSION_BUS_ADDRESS="$bus_address" \
      systemctl --user show mcp-dev-bridge.service --property=LoadState --value 2>/dev/null \
      | grep -qx loaded
}

systemd_bridge_action() {
  local action="$1" runtime_dir bus_address
  shift
  runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  bus_address="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$runtime_dir/bus}"
  XDG_RUNTIME_DIR="$runtime_dir" DBUS_SESSION_BUS_ADDRESS="$bus_address" \
    systemctl --user "$action" "$@" mcp-dev-bridge.service
}

start_command() {
  if systemd_bridge_available; then
    systemd_bridge_action start
    echo "WebHarness started through mcp-dev-bridge.service"
    return 0
  fi
  exec "$ROOT/bin/start"
}

stop_command() {
  if systemd_bridge_available; then
    systemd_bridge_action stop --no-block
    echo "WebHarness stop queued through mcp-dev-bridge.service"
    return 0
  fi
  exec "$ROOT/bin/stop"
}

systemd_bridge_show() {
  local runtime_dir bus_address
  runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  bus_address="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$runtime_dir/bus}"
  XDG_RUNTIME_DIR="$runtime_dir" DBUS_SESSION_BUS_ADDRESS="$bus_address" \
    systemctl --user show mcp-dev-bridge.service --property="$1" --value
}

# A command running inside the bridge unit (for example an MCP exec) is killed by the
# restart it queues, so it can never observe the result.
inside_bridge_unit() {
  grep -q 'mcp-dev-bridge\.service' "${WEBHARNESS_SELF_CGROUP_FILE:-/proc/self/cgroup}" 2>/dev/null
}

# Type=notify makes the unit active only after bin/start passed the public readiness check,
# so a new InvocationID in the active state means the restarted bridge is reachable.
wait_for_bridge_restart() {
  local previous="$1" timeout="$2" interval="${WEBHARNESS_RESTART_POLL_INTERVAL:-1}"
  local deadline=$((SECONDS + timeout)) invocation state
  while :; do
    invocation="$(systemd_bridge_show InvocationID 2>/dev/null || true)"
    state="$(systemd_bridge_show ActiveState 2>/dev/null || true)"
    if [ -n "$invocation" ] && [ "$invocation" != "$previous" ]; then
      case "$state" in
        active) return 0 ;;
        failed)
          echo "mcp-dev-bridge.service failed to restart; see: journalctl --user -u mcp-dev-bridge.service" >&2
          return 1
          ;;
      esac
    fi
    if [ "$SECONDS" -ge "$deadline" ]; then
      echo "timed out after ${timeout}s waiting for mcp-dev-bridge.service (state: ${state:-unknown})" >&2
      return 1
    fi
    sleep "$interval"
  done
}

restart_command() {
  local wait=0 timeout=180 previous
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --wait) wait=1 ;;
      --timeout)
        [ "$#" -ge 2 ] && [[ "$2" =~ ^[1-9][0-9]*$ ]] || { echo "--timeout needs a positive number of seconds" >&2; return 2; }
        timeout="$2"
        shift
        ;;
      *) usage >&2; return 2 ;;
    esac
    shift
  done

  if systemd_bridge_available; then
    if [ "$wait" = 0 ]; then
      systemd_bridge_action restart --no-block
      echo "WebHarness restart queued through mcp-dev-bridge.service"
      return 0
    fi
    if inside_bridge_unit; then
      echo "restart --wait cannot run inside mcp-dev-bridge.service: the restart kills this command." >&2
      echo "Run plain 'webharness restart' and reconnect after about 20 seconds." >&2
      return 2
    fi
    previous="$(systemd_bridge_show InvocationID 2>/dev/null || true)"
    systemd_bridge_action restart --no-block
    echo "WebHarness restart queued through mcp-dev-bridge.service; waiting for readiness"
    wait_for_bridge_restart "$previous" "$timeout" || return 1
    echo "WebHarness restarted and ready"
    return 0
  fi

  "$ROOT/bin/stop"
  exec "$ROOT/bin/start"
}

setup_command() {
  local args=("$@") profile="" i
  for ((i = 0; i < ${#args[@]}; i += 1)); do
    if [ "${args[$i]}" = "--profile" ]; then
      [ $((i + 1)) -lt ${#args[@]} ] || { echo "missing value for --profile" >&2; usage >&2; return 2; }
      profile="${args[$((i + 1))]}"
      break
    fi
  done

  case "$profile" in
    restricted|trusted-dev)
      "$ROOT/scripts/setup.sh" "${args[@]}"
      ;;
    personal|server)
      local forwarded=()
      for ((i = 0; i < ${#args[@]}; i += 1)); do
        if [ "${args[$i]}" = "--profile" ]; then
          i=$((i + 1))
          continue
        fi
        forwarded+=("${args[$i]}")
      done
      if [ "$profile" = server ]; then
        "$ROOT/scripts/bootstrap-server.sh" "${forwarded[@]}"
      else
        "$ROOT/scripts/bootstrap-personal.sh" "${forwarded[@]}"
      fi
      ;;
    "")
      echo "setup requires --profile restricted, --profile trusted-dev, --profile personal, or --profile server" >&2
      usage >&2
      return 2
      ;;
    *)
      echo "unknown profile: $profile" >&2
      usage >&2
      return 2
      ;;
  esac

  install_self
}

COMMAND="${1:-help}"
if [ "$#" -gt 0 ]; then shift; fi

case "$COMMAND" in
  setup)
    setup_command "$@"
    ;;
  doctor)
    exec "$ROOT/scripts/doctor.sh" "$@"
    ;;
  start)
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    start_command
    ;;
  stop)
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    stop_command
    ;;
  restart)
    restart_command "$@"
    ;;
  status)
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    exec "$ROOT/bin/status"
    ;;
  extension)
    [ "$#" -gt 0 ] || { usage >&2; exit 2; }
    exec "$ROOT/bin/extension" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "unknown command: $COMMAND" >&2
    usage >&2
    exit 2
    ;;
esac
