# Local deployment identity for WebHarness.
# Copy to .env and set values for this machine. Trust policy is selected
# explicitly with webharness setup --profile restricted|trusted-dev|personal.

MCP_WORKSPACE_ROOT=/home/user/code
MCP_PUBLIC_URL=https://mcp.example.com
MCP_TUNNEL_NAME=

# Personal profile only. Leave empty to use the WSL user's $HOME.
MCP_PERSONAL_DEFAULT_CWD=

# Personal Terminal presentation frontend. Compatibility default: kitty.
# Alternate value: windows-terminal.
MCP_TERMINAL_FRONTEND=kitty

# Personal owner overlay. Keep the referenced files outside the repository.
# MCP_OWNER_ENV_FILE accepts GALLIUM_DRIVER, MOZ_ENABLE_WAYLAND, and Linux
# browser-fast AGENT_BROWSER_PROFILE / AGENT_BROWSER_EXECUTABLE_PATH. The live
# Linux backend selector is ~/.config/mcp-dev-bridge/browser-fast.json.
MCP_OWNER_CONTEXT_FILE=
MCP_OWNER_ENV_FILE=

# Model-visible Bash never controls this. Increase only as deployment policy.
MCP_DEV_MAX_OUTPUT_BYTES=1048576
