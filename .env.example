# Workspace exposed to the Read/Edit/Write tools.
MCP_WORKSPACE_ROOT=/home/alice/code

# HTTPS URL ChatGPT will use for the MCP connection.
MCP_PUBLIC_URL=https://mcp.example.com

# Optional named Cloudflare tunnel. Leave empty to use your cloudflared defaults.
MCP_TUNNEL_NAME=

# Maximum model-visible Bash output retained in the returned tail (bytes).
MCP_DEV_MAX_OUTPUT_BYTES=1048576
