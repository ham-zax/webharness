# Local deployment identity for WebHarness.
# Copy to .env and set values for this machine. Trust policy is selected
# explicitly with webharness setup --profile restricted|trusted-dev|personal|server.

MCP_WORKSPACE_ROOT=/home/user/code
MCP_PUBLIC_URL=https://mcp.example.com
MCP_TUNNEL_NAME=
# Set this to an available loopback port if WSL mirrored networking reserves 3050.
# The Cloudflare ingress service must use the same port.
MCP_ONE_MCP_PORT=3050
# Keep the tunnel and wake proxy listening while 1MCP sleeps between calls.
# Set BRIDGE_COLD_START=0 for continuously running 1MCP.
BRIDGE_COLD_START=1
# Leave empty to choose the public port +10 (3060 with the default above).
BRIDGE_BACKEND_PORT=
BRIDGE_WAKE_IDLE_MS=600000
# Execution-worker and Local backend idle periods; 0 disables idle eviction.
MCP_DEV_WORKER_IDLE_MS=600000
MCP_LOCAL_INNER_IDLE_MS=1800000

# Personal or Server profile. Leave empty to use the Linux account's $HOME.
MCP_PERSONAL_DEFAULT_CWD=

# Personal Terminal presentation frontend. Compatibility default: kitty.
# Alternate value: windows-terminal.
MCP_TERMINAL_FRONTEND=kitty

# Personal owner overlay. Keep the referenced files outside the repository.
# MCP_OWNER_ENV_FILE accepts GALLIUM_DRIVER, MOZ_ENABLE_WAYLAND, and Linux
# browser-fast AGENT_BROWSER_PROFILE / AGENT_BROWSER_EXECUTABLE_PATH. The live
# Linux backend selector is ~/.config/mcp-dev-bridge/browser-fast.json.
MCP_OWNER_CONTEXT_FILE=
MCP_OWNER_ENV_FILE=

# Personal or Server Local downstream MCPs. Point this at a current-user-owned JSON file
# outside the repository with a standard {"version":"1.0.0","mcpServers":{...}}
# object. Each extra server may set type=stdio and an absolute cwd, and must use an absolute executable command path.
MCP_LOCAL_SERVERS_FILE=

# Model-visible command output and native file ingress limits are deployment policy.
MCP_DEV_MAX_OUTPUT_BYTES=65536
MCP_DEV_READ_DEFAULT_LINES=500
MCP_DEV_IMPORT_MAX_BYTES=104857600
