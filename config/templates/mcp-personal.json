{
  "$schema": "https://docs.1mcp.app/schemas/v1.0.0/mcp-config.json",
  "version": "1.0.0",
  "mcpServers": {
    "dev": {
      "command": "node",
      "args": [
        "__REPO_ROOT__/providers/pi-dev/server.mjs"
      ],
      "env": {
        "MCP_DEV_SHELL_MODE": "unrestricted",
        "MCP_DEV_PATH_MODE": "user",
        "MCP_DEV_STATE_DIR": "__DEV_STATE_DIR__",
        "MCP_DEV_MAX_OUTPUT_BYTES": "__DEV_MAX_OUTPUT_BYTES__",
        "MCP_DEV_MAX_SPOOL_BYTES": "__DEV_MAX_SPOOL_BYTES__",
        "MCP_DEV_SPOOL_TTL_SECONDS": "__DEV_SPOOL_TTL_SECONDS__",
        "MCP_DEV_SPOOL_MAX_TOTAL_BYTES": "__DEV_SPOOL_MAX_TOTAL_BYTES__",
        "MCP_DEV_TERMINAL_SOCKET": "__TERMINAL_SOCKET__",
        "XDG_RUNTIME_DIR": "__RUNTIME_DIR__",
        "WAYLAND_DISPLAY": "wayland-0",
        "DISPLAY": ":0",
        "PULSE_SERVER": "unix:/mnt/wslg/PulseServer"
      },
      "tags": [
        "dev"
      ]
    },
    "code": {
      "command": "node",
      "args": [
        "__REPO_ROOT__/providers/code-router/server.mjs"
      ],
      "env": {},
      "tags": [
        "code"
      ]
    },
    "terminal": {
      "command": "node",
      "args": [
        "__REPO_ROOT__/providers/terminal/mcp-server.mjs"
      ],
      "env": {
        "MCP_TERMINAL_SOCKET": "__TERMINAL_SOCKET__",
        "MCP_TERMINAL_FRONTEND": "__TERMINAL_FRONTEND__",
        "MCP_TERMINAL_READ_MAX_BYTES": "65536"
      },
      "tags": [
        "terminal"
      ]
    },
    "local": {
      "command": "node",
      "args": [
        "__REPO_ROOT__/providers/local-tools/server.mjs"
      ],
      "env": {
        "MCP_LOCAL_INNER_CONFIG": "__LOCAL_INNER_CONFIG__",
        "MCP_LOCAL_ONE_MCP_ENTRY": "__ONE_MCP_ENTRY__"
      },
      "tags": [
        "local"
      ]
    }
  }
}
