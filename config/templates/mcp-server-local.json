{
  "version": "1.0.0",
  "mcpServers": {
    "skill-library": {
      "command": "node",
      "args": ["__REPO_ROOT__/providers/skill-library/server.mjs"],
      "env": {
        "MCP_SKILL_POLICY_FILE": "__SKILL_POLICY_FILE__",
        "MCP_SKILL_JEV_ENABLED": "__SKILL_JEV_ENABLED__",
        "MCP_SKILL_JEV_ENV_FILE": "__SKILL_JEV_ENV_FILE__"
      }
    },
    "terminal": {
      "command": "node",
      "args": [
        "__REPO_ROOT__/providers/terminal/mcp-server.mjs"
      ],
      "env": {
        "MCP_TERMINAL_SOCKET": "__TERMINAL_SOCKET__",
        "MCP_TERMINAL_READ_MAX_BYTES": "65536"
      }
    }
  }
}
